############################################################
#
# SI - Ge/AU PLASMONIC STRUCTURE
#
# FDTD - Ansys Lumerical 2025 R1.3
#
# PARAMETRIZED STRUCTURE
#
# X = propagation direction
# Y = lateral direction
# Z = vertical direction
#
# STRUCTURE:

############################################################
# CLEAN START
############################################################

clear;
switchtolayout;
deleteall;

############################################################
# WAVELENGTH
############################################################

lambda0 = 1.55e-6;


############################################################
# ==========================================================
# MAIN PARAMETER
# ==========================================================
############################################################

Si_W_in = 440e-9;
Si_W_min = 100e-9;
Si_H = 220e-9;

# GOLD / SILVER
# ==========================================================
############################################################

Au_W = 1.0e-6; #600e-9;
Au_H = Si_H;
# SiO2
# ==========================================================
############################################################

SiO2_bottom_H = 2e-6;
SiO2_side = Au_W + Si_W_in/2;
SiO2_top_H = 1e-6;


# GE
# ==========================================================
############################################################

Ge_W = Si_W_min;
Ge_L = 1.0e-6;
Ge_H = Si_H;

############################################################
# ==========================================================
# MATERIALS
# ==========================================================
############################################################

Si_mat = "Si (Silicon) - Palik";
SiO2_mat = "SiO2 (Glass) - Palik";
Ge_mat = "Ge (Germanium) - Palik";
Au_mat = "Au (Gold) - Palik";
Ag_mat = "Ag (Silver) - CRC";
TiO2_mat = "TiO2 (Titanium Dioxide) - Devore";
Air = "etch";


############################################################
# ==========================================================
# LONGITUDES EN X
# ==========================================================
############################################################

L_input = 12.0e-6;
L_taper = 2.0e-6;
L_Ge = 1.0e-6;
#L_output = 0.0e-6;

# TOTAL LENGTH
# ==========================================================
############################################################

L_total = L_input + L_taper + L_Ge + L_taper;

# POSICIONES X
# ==========================================================
############################################################

x0 = -L_total/2;
x1 = x0 + L_input;
x2 = x1 + L_taper;
x3 = x2 + L_Ge;
x4 = x3 + L_taper;
#x5 = x4 + L_output;

# POSICIONES Z
# ==========================================================
############################################################

Si_zmin = 0;
Si_zmax = Si_H;
Ge_zmin = Si_zmin;
Ge_zmax = Si_zmax;
Au_zmin = Si_zmin;
Au_zmax = Si_zmax;

############################################################
# ==========================================================
# SILICON
# ==========================================================
############################################################

# SILICON INPUT
# ==========================================================
############################################################

addrect;
set("material",Si_mat);
set("name","Si_Input");
##set("mesh order",1);
set("x min",x0);
set("x max",x1);
set("y min",-Si_W_in/2);
set("y max",Si_W_in/2);
set("z min",Si_zmin);
set("z max",Si_zmax);

# SILICON TAPER 
# ==========================================================
############################################################

addpoly;

set("name","Si_Taper_Left");
set("material",Si_mat);
#set("mesh order",1);
set("z min",Si_zmin);
set("z max",Si_zmax);
V = matrix(4,2);
V(1,1) = x1;
V(1,2) = -Si_W_in/2;
V(2,1) = x1;
V(2,2) = Si_W_in/2;
V(3,1) = x2;
V(3,2) = Si_W_min/2;
V(4,1) = x2;
V(4,2) = -Si_W_min/2;
set("vertices",V);

############################################################
# ==========================================================
# GE
# ==========================================================
############################################################

addrect;

set("name","Ge");
set("material",Ge_mat);
#set("mesh order",2);
set("x min",x2);
set("x max",x3);
set("y min",-Ge_W/2);
set("y max",Ge_W/2);
set("z min",Ge_zmin);
set("z max",Ge_zmax);




############################################################
# ==========================================================
#Silver LOWER PATH
# ==========================================================
############################################################

addpoly;

set("name","Au_Lower_Path");
set("material",Au_mat);
#set("mesh order",2);
set("z min",Au_zmin);
set("z max",Au_zmax);
V = matrix(6,2);
V(1,1) = x1;
V(1,2) = -Si_W_in/2;
V(2,1) = x2;
V(2,2) = -Ge_W/2;
V(3,1) = x3;
V(3,2) = -Ge_W/2;
V(4,1) = x3;
V(4,2) = -Si_W_in/2-Au_W;   # -Ge_W/2-Au_W;
V(5,1) = x2;
V(5,2) = -Si_W_in/2-Au_W;    # -Ge_W/2-Au_W;
V(6,1) = x1;
V(6,2) = -Si_W_in/2-Au_W;
set("vertices",V);


############################################################
# ==========================================================
# GOLD UPPER PATH
#
# COMPLETELY UNCHANGED
# ==========================================================
############################################################

addpoly;
set("name","Au_Upper_Path");
set("material",Au_mat);
#set("mesh order",2);
set("z min",Au_zmin);
set("z max",Au_zmax);
V = matrix(6,2);
V(1,1) = x1;
V(1,2) = Si_W_in/2;
V(2,1) = x2;
V(2,2) = Ge_W/2;
V(3,1) = x3;
V(3,2) = Ge_W/2;
V(4,1) = x3;
V(4,2) = Si_W_in/2+Au_W; # Ge_W/2+Au_W;
V(5,1) = x2;
V(5,2) = Si_W_in/2+Au_W; #Ge_W/2+Au_W;
V(6,1) = x1;
V(6,2) = Si_W_in/2+Au_W;
set("vertices",V);

############################################################
# ==========================================================
# SiO2 
# ==========================================================
############################################################

# SiO2 Bottom
# ==========================================================
addrect;

set("name","SiO2_bottom");
set("material",SiO2_mat);
#set("mesh order",3);
set("x min",x0);
set("x max",x3);
set("y min",-SiO2_side);
set("y max",SiO2_side);
set("z min",-SiO2_bottom_H);
set("z max",0);

# SiO2 Top
# ==========================================================
addrect;
set("name","SiO2_top");
set("material",SiO2_mat);
#set("mesh order",3);
set("x min",x0);
set("x max",x1);
set("y min",-SiO2_side);
set("y max",SiO2_side);
set("z min",0);
set("z max",Si_H + SiO2_top_H);
set("Alpha",0.2);

addrect;
set("name","SiO2_top");
set("material",SiO2_mat);
#set("mesh order",3);
set("x min",x1);
set("x max",x2);
set("y min",-SiO2_side);
set("y max",SiO2_side);
set("z min",Ge_H);
set("z max",Si_H + SiO2_top_H);
set("Alpha",0.2);


############################################################
# ==========================================================
# FDTD REGION
# ==========================================================
############################################################

addfdtd;
set("x min",x0-0.5e-6);
set("x max",x3+0.5e-6);
set("y min",-1.5e-6);
set("y max",1.5e-6);
set("z min",-0.8e-6);
set("z max",0.8e-6);
set("background material",Air);

############################################################
# ==========================================================
# LOCAL MESH
# ==========================================================
############################################################

addmesh;
set("name","Mesh_Plasmonic");
set("x min",x1-0.2e-6);
set("x max",x4+0.2e-6);
set("y min",-Ge_W/2-Au_W-0.2e-6);
set("y max",Ge_W/2+Au_W+0.2e-6);
set("z min",Ge_zmin-0.1e-6);
set("z max",Ge_zmax+0.1e-6);
set("dx",5e-9);
set("dy",5e-9);
set("dz",5e-9);


############################################################
# ==========================================================
# MODE SOURCE
# ==========================================================
############################################################

addmode;
set("name","Mode_Source");
set("injection axis","x-axis");
set("direction","forward");
source_x = x0+0.5e-6;
set("x",source_x);
set("y",0);
set("z",Si_H/2);
set("y span",1.5e-6);
set("z span",1.0e-6);
set("wavelength start",lambda0);
set("wavelength stop",lambda0);
set("mode selection","fundamental mode");

############################################################
# ==========================================================
# FIELD MONITOR INPUT
# ==========================================================
############################################################

adddftmonitor;
set("name","Mode_Check_Input");
set("monitor type","2D X-normal");
set("x",x0/2);
set("y",0);
set("y span",1.5e-6);
set("z",Si_H/2);
set("z span",1.0e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

############################################################
# ==========================================================
# FIELD MONITOR CENTER
# ==========================================================
############################################################

adddftmonitor;
set("name","Field_Ge_Au_Center");
set("monitor type","2D X-normal");
set("x",x1+1e-6);
set("y",0);
set("y span",1.0e-6);
set("z",0.125e-6);
set("z span",0.5e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

adddftmonitor;
set("name","Field_Ge_Au_end");
set("monitor type","2D X-normal");
set("x",x3);
set("y",0);
set("y span",1.0e-6);
set("z",0.125e-6);
set("z span",0.5e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

adddftmonitor;
set("name","Field_Ge_Center");
set("monitor type","2D X-normal");
set("x",5.5e-6);
set("y",0);
set("y span",1.0e-6);
set("z",0.125e-6);
set("z span",0.5e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);


############################################################
# ==========================================================
# MODE EXPANSION INPUT
# ==========================================================
############################################################

adddftmonitor;
set("name","ME_Input_Field");
set("monitor type","2D X-normal");
set("x",x0+1.5e-6);
set("y",0);
set("y span",1.5e-6);
set("z",Si_H/2);
set("z span",1.0e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

############################################################
# MONITOR LINEAL
############################################################
adddftmonitor;
set("name","T");
set("monitor type","Linear Y");
set("x", 5.5e-6) ;
set("y", 0);
set("y span", Ge_W);
set("z",Ge_zmax/2);

############################################################
# MONITOR LINEAL
############################################################
adddftmonitor;
set("name","R");
set("monitor type","Linear Y");
set("x", 6.5e-6) ;
set("y", 0);
set("y span", Ge_W);
set("z",Ge_zmax/2);



############################################################
# REGION DE GENERACION
############################################################
addobject("CW_generation");

set("name","CW_Generation_PMMA_Au");
set("x", 6e-6) ;
set("x span", 1e-6);
set("y", 0);
set("y span", Ge_W);
set("z",Ge_zmax/2);
set("z span", Ge_H);
set("source intensity",1);
set("average dimension","none");

#addobject("Power absorbed");

#set("name","P_abs_Ge");
#set("x", 6e-6) ;
#set("x span", 1e-6);
#set("y", 0);
#set("y span", Ge_W);
#set("z",Ge_zmax/2);
#set("z span", Ge_H);
##set("source intensity",1);
##set("average dimension","none");


############################################################
# REGION DE GENERACION
############################################################
adddftmonitor;
set("name","Ge_Abs");
set("monitor type","3D");
set("x min",x2);
set("x max",x3);
set("y min",-Ge_W/2);
set("y max", Ge_W/2);
set("z min",Ge_zmin);
set("z max",Ge_zmax);
set("override global monitor settings",1);
set("frequency points",1);


