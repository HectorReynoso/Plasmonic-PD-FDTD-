############################################################
# ABSORCION EN Ge
############################################################
lambda0 = 1.55e-6;

# Frecuencia
f = c/lambda0;

# Potencia de la fuente
Pin_source = sourcepower(f);

############################################################
# FLUJO DE POTENCIA EN x = 5.5 um (inicio Ge)
############################################################

P1 = getresult("Field_Ge_Center","P");

Px1 = real(P1.Px);

P_in = max(Px1);

############################################################
# FLUJO DE POTENCIA EN x = 6.5 um (fin Ge)
############################################################

P2 = getresult("Field_Ge_Au_end","P");

Px2 = real(P2.Px);

P_out = max(Px2);

############################################################
# ABSORCION
############################################################

P_abs = P_in-P_out;

Absorption = 100*P_abs/P_in;

?"==============================";
?"ABSORCION EN Ge";
?"==============================";

?"P entrada =";
?P_in;

?"P salida =";
?P_out;

?"P absorbida =";
?P_abs;

?"Absorcion (%) =";
?Absorption;
