L_taper = 2.0e-6;
L_Ge = 1.0e-6;
#L_output = 0.0e-6;

# TOTAL LENGTH
# ==========================================================
############################################################

L_total = L_input + L_taper + L_Ge + L_taper;

# POSICIONES X
# ==========================================================
############################################################

x0 = -L_total/2;
x1 = x0 + L_input;
x2 = x1 + L_taper;
x3 = x2 + L_Ge;
x4 = x3 + L_taper;
#x5 = x4 + L_output;

# POSICIONES Z
